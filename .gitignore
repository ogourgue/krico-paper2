# macOS
.DS_Store
**/.DS_Store

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# As in krico-paper1: small aggregated data (data/*.nc) and rendered
# figures (*.png) are committed so a figure reproduces from plot.py alone.
**/*.pdf

# SLURM logs
**/*.out
ecsbatch.log.*

# Exploratory work that has not earned an F/FS/S prefix (see README).
explore/**/data/

# ERA5 fields downloaded from the Climate Data Store are not committed:
# the request file, sha256 and fetch log in each folder are the record,
# and anyone can re-download the same bytes with fetch.py.
indices/zw3/raw/era5_v500_monthly.nc
local/subarea/raw/*.nc
